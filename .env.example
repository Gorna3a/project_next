# ─── Firebase ─────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Base64 of the Firebase Admin service-account JSON (Console → Project
# Settings → Service accounts → Generate new private key). Server-only:
# used by /api/xp/award. Produce with:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\adminsdk.json"))
# (PowerShell) — one line, safe for Vercel env vars. NEVER commit it.
FIREBASE_SERVICE_ACCOUNT_B64=base64_of_service_account_json

# ─── Google Gemini AI (free at aistudio.google.com) ───────────
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Sanity CMS ───────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ─── Code Execution (Judge0 via same-origin proxy) ──────────────────
# Browser → NEXT_PUBLIC_JUDGE0_URL → JUDGE0_UPSTREAM.
# Defaults work against the public server; set JUDGE0_UPSTREAM for prod.
NEXT_PUBLIC_JUDGE0_URL=/api/judge0
# JUDGE0_UPSTREAM=https://ce.judge0.com

# ─── Arduino Simulator engine ─────────────────────────────────
# mock (default) | local (custom workspace scaffold; no iframe) | wokwi (live Wokwi embed)
NEXT_PUBLIC_ARDUINO_ENGINE=mock
# NEXT_PUBLIC_WOKWI_CLIENT_ID=
# NEXT_PUBLIC_ARDUINO_FIRMWARE_HEX_URL=/arduino/blink.hex
# NEXT_PUBLIC_ARDUINO_FIRMWARE_ELF_URL=/arduino/blink.elf
