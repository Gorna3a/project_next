// ─── deployed 2026-10-04 ─────────────────────────────────────────────
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── User profiles ────────────────────────────────────────────────────
    // Readable by any signed-in user (public profiles, user search, friends,
    // leaderboards, duel invites). Writes are owner-only; only admins may
    // change roles or touch other users' docs. Signups always create
    // role == "student" — teachers/admins are promoted via UserManagement.

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student';
      allow update: if isAdmin()
        || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isOwner(userId) || isAdmin();

      // Private per-user data — owner only
      match /courseProgress/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /chats/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /completedChallenges/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /enrolledClassrooms/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy single-doc projects (migration source) — keep until fully migrated
    match /projects/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /dailyChallenges/{dailyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ─── Public curriculum content ────────────────────────────────────────

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ─── Social ───────────────────────────────────────────────────────────

    match /friend_requests/{requestId} {
      // GETs by fixed id (e.g. uidA_uidB) happen even when no doc exists;
      // evaluating `resource.data.*` on a null resource errors out to deny.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users;
      allow update, delete: if signedIn()
        && request.auth.uid in resource.data.users;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ─── Bookmarks (private to their owner via the userId field) ──────────

    match /bookmarks/{bookmarkId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ─── Duels ────────────────────────────────────────────────────────────

    match /duel_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.creatorId == request.auth.uid
        || resource.data.opponentId == request.auth.uid
        // Joining an open room: may only set yourself as opponent
        || (
          resource.data.opponentId == null
          && request.resource.data.opponentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['opponentId', 'opponentName', 'status', 'startTime'])
        )
      );
      allow delete: if isAdmin();
    }

    match /competitive_leaderboard/{entryId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Legacy dashboard collection name (see AdminDashboard)
    match /duelRooms/{roomId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ─── Classrooms ───────────────────────────────────────────────────────
    // Reads are signed-in (join-by-code lookup needs to find the room before
    // becoming a member). Writes: teachers own their rooms; students may only
    // add themselves to `students` (self-enroll, never remove others).

    match /classrooms/{classroomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.teacherId == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
          && request.resource.data.students.hasAll(resource.data.students)
          && request.auth.uid in request.resource.data.students
        )
      );
      allow delete: if signedIn()
        && (resource.data.teacherId == request.auth.uid || isAdmin());

      match /assignments/{assignmentId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/classrooms/$(classroomId)).data.students
        );
        allow write: if signedIn()
          && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid;
      }
    }
  }
}
