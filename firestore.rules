// ─── rules v2 (2026-11-04) — XP is server-authoritative ─────────────
// XP / level / streak / leaderboard are committed exclusively by
// POST /api/xp/award via the Firebase Admin SDK, which bypasses these
// rules. Clients can no longer write those fields at all.
//
// NOT DEPLOYED until `firebase deploy --only firestore:rules` is run.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── User profiles ────────────────────────────────────────────────
    // Owner updates: display name, avatar + its source marker, preferences
    // and lastActive (login touch). Everything that implies progression —
    // totalXP, level, streak, lastStreakDate, role, uid, email, createdAt —
    // is rejected for clients here, even for the document owner.

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.totalXP == 0
        && request.resource.data.level == 1
        && request.resource.data.streak == 0;
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'photoURL', 'photoSource', 'preferences', 'lastActive'])
        );
      allow delete: if isOwner(userId) || isAdmin();

      // Server-maintained: courseProgress is written only by /api/xp/award.
      match /courseProgress/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /chats/{docId} {
        allow read, write: if isOwner(userId);
      }
      // Server-maintained completion ledger (write = server only).
      match /completedChallenges/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /enrolledClassrooms/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Server-only XP ledger — no client access whatsoever.
    match /xpEvents/{docId} {
      allow read, write: if false;
    }

    // Legacy single-doc projects (migration source) — keep until fully migrated
    match /projects/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /dailyChallenges/{dailyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ─── Public curriculum content ───────────────────────────────────

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ─── Social ───────────────────────────────────────────────────────

    match /friend_requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users;
      allow update, delete: if signedIn()
        && request.auth.uid in resource.data.users;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ─── Bookmarks (private to their owner via the userId field) ──────

    match /bookmarks/{bookmarkId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ─── Duels ────────────────────────────────────────────────────────
    // Clients may: join an open room as a participant, and flip their own
    // thinking/answered/finished marker. Clients may NEVER set winnerId or
    // force the room into 'finished' — that is the server's job (fair,
    // race-proof). Status 'finished' is set only by /api/xp/award.

    match /duel_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if signedIn() && (
        // Creator updates own status only
        (resource.data.creatorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creatorStatus']))
        // Opponent updates own status only
        || (resource.data.opponentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opponentStatus']))
        // Joining an open room: may only set yourself as opponent
        || (
          resource.data.opponentId == null
          && request.resource.data.opponentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['opponentId', 'opponentName', 'status', 'startTime'])
        )
      );
      allow delete: if isAdmin();
    }

    // Read-only for clients; writes happen server-side.
    match /competitive_leaderboard/{entryId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Legacy dashboard collection name (see AdminDashboard)
    match /duelRooms/{roomId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ─── Classrooms ───────────────────────────────────────────────────

    match /classrooms/{classroomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.teacherId == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
          && request.resource.data.students.hasAll(resource.data.students)
          && request.auth.uid in request.resource.data.students
        )
      );
      allow delete: if signedIn()
        && (resource.data.teacherId == request.auth.uid || isAdmin());

      match /assignments/{assignmentId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/classrooms/$(classroomId)).data.students
        );
        allow write: if signedIn()
          && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid;
      }
    }
  }
}
